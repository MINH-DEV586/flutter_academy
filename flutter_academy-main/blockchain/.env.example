# ── Ethereum Sepolia Testnet ──────────────────────────────────────────────
# RPC URL (lấy từ Infura, Alchemy, hoặc dịch vụ khác)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key của tài khoản deploy (KHÔNG dùng ví có tiền thật)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Sau khi deploy ───────────────────────────────────────────────────────
# Địa chỉ Smart Contract đã deploy
CONTRACT_ADDRESS=

# Event topic hash cho Deposit(bytes32,address,uint256,uint256,uint256,uint256)
# Tính bằng: ethers.id("Deposit(bytes32,address,uint256,uint256,uint256,uint256)")
# Sẽ được in ra khi chạy script deploy.
DEPOSIT_EVENT_TOPIC=
